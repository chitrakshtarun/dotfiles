{
  "window.commandCenter": true,
  "workbench.colorTheme": "One Dark Pro",
  "workbench.colorCustomizations": {
    "[One Dark Pro]": {
      "editor.background": "#000000",
      "sideBar.background": "#000000",
      "sideBar.border": "#3b3b3b",
      "activityBar.background": "#000000",
      "activityBar.border": "#3b3b3b",
      "titleBar.activeBackground": "#000000",
      "titleBar.inactiveBackground": "#000000",
      "titleBar.border": "#3b3b3b",
      "editorGroupHeader.tabsBackground": "#000000",
      "editorGroupHeader.noTabsBackground": "#000000",
      "tab.activeBackground": "#000000",
      "tab.inactiveBackground": "#000000",
      "tab.border": "#3b3b3b",
      "statusBar.background": "#000000",
      "statusBar.border": "#3b3b3b",
      "statusBar.noFolderBackground": "#000000",
      "statusBar.debuggingBackground": "#000000",
      "panel.background": "#000000",
      "panel.border": "#3b3b3b",
      "terminal.background": "#000000",
      "terminal.border": "#3b3b3b",
      "terminal.ansiBlack": "#000000",
      "terminal.ansiBlue": "#61AFEF",
      "terminal.ansiCyan": "#56B6C2",
      "terminal.ansiGreen": "#98C379",
      "terminal.ansiMagenta": "#C678DD",
      "terminal.ansiRed": "#E06C75",
      "terminal.ansiWhite": "#ABB2BF",
      "terminal.ansiYellow": "#E5C07B",

      // 🛠 Fixes for Outline/Timeline/Explorer/Other Panels
      "editorGroup.border": "#3b3b3b",
      "peekViewEditor.background": "#000000",
      "peekViewResult.background": "#000000",
      "peekViewTitle.background": "#000000",
      "peekViewTitleDescription.foreground": "#3b3b3b",
      "peekViewTitleLabel.foreground": "#ffffff",
      "list.hoverBackground": "#000000",
      "list.inactiveSelectionBackground": "#000000",
      "list.activeSelectionBackground": "#000000",
      "list.focusBackground": "#000000",
      "list.dropBackground": "#000000",
      "sideBarSectionHeader.background": "#000000",
      "sideBarSectionHeader.border": "#3b3b3b",
      "sideBarSectionHeader.foreground": "#ffffff",
      "editorWidget.background": "#000000",
      "editorWidget.border": "#3b3b3b",
      "panelSection.border": "#3b3b3b",
      "panelSectionHeader.background": "#000000",
      "panelSectionHeader.foreground": "#ffffff",
      "panelSectionHeader.border": "#3b3b3b",
      "breadcrumb.background": "#000000",
      "breadcrumb.foreground": "#ffffff",
      "breadcrumb.focusForeground": "#ffffff",
      "breadcrumb.activeSelectionForeground": "#ffffff",
      "menu.background": "#000000",
      "menu.foreground": "#ffffff",
      "menu.border": "#3b3b3b",
      "menu.selectionBackground": "#000000",
      "menu.selectionBorder": "#3b3b3b",
    },
  },
  "workbench.iconTheme": "material-icon-theme",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "editor.formatOnType": true,
  "prettier.printWidth": 120,
  "editor.tokenColorCustomizations": {
    "textMateRules": [],
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "diffEditor.ignoreTrimWhitespace": false,
  "workbench.settings.applyToAllProfiles": [],
  "workbench.editor.customLabels.patterns": {
    "**/app/**/{page,layout,route,template,loading,index,_layout,[id]}.{tsx,ts,jsx,js}": "${dirname}/${filename}.${extname}",
  },
  "editor.formatOnSave": true,
  "explorer.confirmPasteNative": false,
  "cursor.composer.usageSummaryDisplay": "always",
  "claudeCode.preferredLocation": "panel",
  "window.autoDetectColorScheme": false,
}
